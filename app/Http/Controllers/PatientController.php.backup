<?php

namespace App\Http\Controllers;

use App\Http\Requests\StorePatient;
use App\Models\Patient;
use Exception;
use Illuminate\Http\Request;
use Illuminate\Support\Str;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Storage;
use Illuminate\Support\Facades\View;
use Mpdf\Mpdf;
use Illuminate\Support\Facades\Log;
use Illuminate\Support\Facades\Auth;
use App\Models\ClinicalHistories;

class PatientController extends Controller
{
    public function list()
    {
        $patients = Patient::all();
        return view('patients.list', compact('patients'));
    }

    public function add()
    {
        // Obtener el estado de conexión desde la sesión
        $isOnline = session('connection_status', true); // Si no existe, el valor predeterminado será 'true'

        return view('patients.created', compact('isOnline'));
    }
    public function insert(StorePatient $request)
    {
        // --- INICIO DE LA LÓGICA DE SINCRONIZACIÓN OFFLINE (SE QUEDA IGUAL) ---
        if ($request->has('_offline_sync')) {
            try {
                Log::info('🔧 Datos recibidos para sincronización:', $request->all());

                if ($request->isJson()) {
                    $validated = $request->validate([
                        'dni' => 'required|string|size:8',
                        'names' => 'required|string|max:255',
                        'surnames' => 'required|string|max:255',
                        'phone' => 'nullable|string|max:15',
                        'history_number' => 'nullable|string|max:50',
                        'date' => 'nullable|date',
                    ]);
                } else {
                    $validated = $request->validated();
                }

                Log::info('✅ Datos validados (offline):', $validated);

                // --- CAMBIO MÍNIMO Y CRUCIAL (OFFLINE) ---
                $patientData = [
                    'dni' => $validated['dni'],
                    'names' => $validated['names'],
                    'surnames' => $validated['surnames'],
                    'phone' => $validated['phone'] ?? null,
                    // Se guarda la fecha de nacimiento directamente en la columna 'age'.
                    'age' => $validated['date'] ?? null,
                    'history_number' => $validated['history_number'] ?? null,
                ];

                Log::info('📊 Datos finales para crear paciente (offline):', $patientData);
                $patient = Patient::create($patientData);

                return response()->json([
                    'success' => true,
                    'message' => 'Paciente sincronizado desde IndexedDB',
                    'patient_id' => $patient->id
                ]);
            } catch (\Illuminate\Validation\ValidationException $e) {
                Log::error('❌ Error de validación (offline):', $e->errors());
                return response()->json(['success' => false, 'message' => 'Error de validación.', 'errors' => $e->errors()], 422);
            } catch (\Exception $e) {
                Log::error('❌ Error creando paciente (offline):', ['message' => $e->getMessage(), 'trace' => $e->getTraceAsString()]);
                return response()->json(['success' => false, 'message' => 'Error interno: ' . $e->getMessage()], 500);
            }
        }
        // --- FIN DE LA LÓGICA DE SINCRONIZACIÓN OFFLINE ---

        // --- INICIO DE LA LÓGICA NORMAL (FORMULARIO WEB) ---
        try {
            $validated = $request->validated();

            // --- CAMBIO MÍNIMO Y CRUCIAL (WEB) ---
            $patientData = [
                'dni' => $validated['dni'],
                'names' => $validated['names'],
                'surnames' => $validated['surnames'],
                'phone' => $validated['phone'] ?? null,
                // Se guarda la fecha de nacimiento directamente en la columna 'age'.
                'age' => $validated['date'] ?? null,
                'history_number' => $validated['history_number'] ?? null,
            ];

            $patient = Patient::create($patientData);

            return redirect('recisa/patients/list')->with('success', 'Paciente ' . $patient->names . ' registrado exitosamente');
        } catch (\Exception $e) {
            return redirect()->back()->withErrors(['error' => 'Error al registrar paciente: ' . $e->getMessage()]);
        }
    }
    /**
     * Calcular edad desde fecha de nacimiento
     */
    private function calculateAge($birthDate)
    {
        if (!$birthDate) {
            return null;
        }

        try {
            $birth = new \DateTime($birthDate);
            $today = new \DateTime();
            $age = $today->diff($birth)->y;
            return $age;
        } catch (\Exception $e) {
            Log::warning('Error calculando edad:', ['date' => $birthDate, 'error' => $e->getMessage()]);
            return null;
        }
    }


    public function edit($slug)
    {
        // Buscar al usuario cuyo slug generado coincide con el parámetro
        $patient = Patient::all()->firstWhere(function ($patient) use ($slug) {
            return $patient->slug === $slug;
        });
        if (empty($patient)) {
            return view('page.404');
        }
        return view('patients.edit', compact('patient'));
    }

    public function update($slug, Request $request)
    {
        // Generar el slug dinámicamente
        $generatedSlug = Str::slug($slug);

        // Buscar al paciente cuyo slug generado coincide con el parámetro
        $patient = Patient::all()->firstWhere(function ($patient) use ($generatedSlug) {
            return $patient->slug === $generatedSlug;
        });
        // Validaciones
        request()->validate([
            'dni' => 'required|regex:/^[0-9]{8}$/|unique:patients,dni,' . $patient->id,
            'phone' => 'required|regex:/^[0-9]{9}$/|unique:patients,phone,' . $patient->id
        ]);

        // Actualizar campos del paciente
        $patient->phone = $request->phone;

        $patient->save();
        return redirect('recisa/patients/list')->with('success', 'El paciente ' . $patient->names . ' fue actualizado');
    }

    public function delete($id)
    {
        $patient = Patient::find($id);
        $patient->delete();
        return redirect('recisa/patients/list')->with('success', 'El paciente ' . $patient->names . ' fue eliminado');
    }
    public function reporte()
    {
        try {
            // ✅ AUMENTAR TIEMPO LÍMITE
            set_time_limit(120);
            ini_set('max_execution_time', 120);

            Log::info('📊 Iniciando generación de reporte de pacientes');

            // Obtener todos los pacientes
            $patients = Patient::all();

            // ✅ CONFIGURACIÓN OPTIMIZADA DE mPDF
            $mpdf = new Mpdf([
                'mode' => 'utf-8',
                'format' => 'A4',
                'tempDir' => storage_path('app/temp'),

                // ✅ CONFIGURACIONES CRÍTICAS PARA EVITAR TIMEOUTS
                'curlTimeout' => 3, // Timeout corto para recursos externos
                'curlFollowLocation' => false, // No seguir redirects
                'allowedRemoteHosts' => [], // Bloquear hosts remotos
                'useActiveForms' => false, // Desactivar formularios activos

                // ✅ CONFIGURACIONES DE MEMORIA
                'fontDir' => [public_path('fonts/')],
                'default_font' => 'Arial'
            ]);

            // ✅ DESACTIVAR DESCARGA DE RECURSOS EXTERNOS
            $mpdf->curlAllowUnsafeSslRequests = false;

            // Cargar la vista de manera más eficiente
            $html = view('report.patient_report_optimized', compact('patients'))->render();

            // ✅ LIMPIAR HTML DE RECURSOS EXTERNOS
            $html = $this->cleanHtmlForPdf($html);

            Log::info('✅ HTML generado, creando PDF');

            // Configurar el pie de página
            $footerHtml = '<div style="text-align: center; font-size: 10px;">Página {PAGENO} de {nbpg}</div>';
            $mpdf->SetHTMLFooter($footerHtml);

            // Escribir HTML al PDF
            $mpdf->WriteHTML($html);

            Log::info('🎉 PDF generado exitosamente');

            // Devolver el PDF
            return response($mpdf->Output('reporte_pacientes.pdf', 'I'))
                ->header('Content-Type', 'application/pdf');
        } catch (\Exception $e) {
            Log::error('❌ Error generando reporte PDF:', [
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString()
            ]);

            return response()->json([
                'error' => 'Error generando reporte: ' . $e->getMessage()
            ], 500);
        }
    }

    private function cleanHtmlForPdf($html)
    {
        // Eliminar CSS externo
        $html = preg_replace('/<link[^>]*href=["\']https?:\/\/[^"\']*["\'][^>]*>/i', '', $html);

        // Eliminar JavaScript
        $html = preg_replace('/<script[^>]*>.*?<\/script>/is', '', $html);

        // Eliminar imágenes externas
        $html = preg_replace('/<img[^>]*src=["\']https?:\/\/[^"\']*["\'][^>]*>/i', '', $html);

        // Agregar CSS básico inline
        $css = '<style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        .header { text-align: center; margin-bottom: 30px; }
        table { width: 100%; border-collapse: collapse; margin: 20px 0; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; font-size: 12px; }
        th { background-color: #f2f2f2; font-weight: bold; }
        .title { font-size: 18px; font-weight: bold; margin-bottom: 20px; }
    </style>';

        return $css . $html;
    }


    public function report_patient($dni)
    {
        try {
            set_time_limit(60);

            Log::info('📊 Generando reporte individual para DNI: ' . $dni);

            // ✅ USAR LAS RELACIONES CORRECTAS SEGÚN TUS MODELOS
            $patient = Patient::where('dni', $dni)
                ->with([
                    'appointments' => function ($query) {
                        $query->orderBy('date', 'desc');
                    },
                    'appointments.doctor',              // UserSpecialization
                    'appointments.doctor.user',         // User del UserSpecialization
                    'appointments.doctor.specialization' // Specialization del UserSpecialization
                ])
                ->first();

            // ✅ VERIFICAR QUE EL PACIENTE EXISTE
            if (!$patient) {
                Log::warning('❌ Paciente no encontrado:', ['dni' => $dni]);
                return response()->json([
                    'error' => 'Paciente no encontrado con DNI: ' . $dni
                ], 404);
            }

            Log::info('📋 Paciente encontrado:', [
                'id' => $patient->id,
                'name' => $patient->names . ' ' . $patient->surnames,
                'appointments_count' => $patient->appointments ? $patient->appointments->count() : 0
            ]);

            // ✅ CONFIGURACIÓN SIMPLIFICADA SIN FUENTES EXTERNAS
            $mpdf = new Mpdf([
                'mode' => 'utf-8',
                'format' => 'A4',
                'tempDir' => storage_path('app/temp'),
                'curlTimeout' => 3,
                'allowedRemoteHosts' => [],
                'useActiveForms' => false,
                'default_font' => 'Arial',
                'fontDir' => [],
                'fontdata' => []
            ]);

            $mpdf->curlAllowUnsafeSslRequests = false;

            // ✅ USAR LA VISTA CORREGIDA
            $html = view('report.patient_dni_report', compact('patient'))->render();

            // ✅ LIMPIAR HTML SI TIENES LA FUNCIÓN
            if (method_exists($this, 'cleanHtmlForPdf')) {
                $html = $this->cleanHtmlForPdf($html);
            }

            $footerHtml = '<div style="text-align: center; font-size: 10px;">Página {PAGENO} de {nbpg}</div>';
            $mpdf->SetHTMLFooter($footerHtml);
            $mpdf->WriteHTML($html);

            Log::info('✅ PDF generado exitosamente para DNI: ' . $dni);

            return response($mpdf->Output('reporte_paciente_' . $dni . '.pdf', 'I'))
                ->header('Content-Type', 'application/pdf');
        } catch (\Exception $e) {
            Log::error('❌ Error generando reporte individual:', [
                'dni' => $dni,
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
                'line' => $e->getLine(),
                'file' => $e->getFile()
            ]);

            return response()->json([
                'error' => 'Error generando reporte: ' . $e->getMessage()
            ], 500);
        }
    }

    public function updateHistory(Request $request, $id)
    {
        // 1. Validación
        $request->validate([
            'history_number' => 'required|string|max:10|unique:patients,history_number,' . $id,
            'files.*' => 'nullable|file|mimes:pdf,jpg,png,jpeg|max:2048'
        ]);

        try {
            $patient = Patient::findOrFail($id);
            $patient->history_number = $request->history_number;
            $patient->save();

            if ($request->hasFile('files')) {
                foreach ($request->file('files') as $file) {
                    $fileName = time() . '_' . $file->getClientOriginalName();
                    $filePath = $file->storeAs('clinical_histories/' . $patient->id, $fileName, 'public');
                    ClinicalHistories::create([
                        'id_patient' => $patient->id,
                        'source_pdf' => $filePath,
                        'datetime_created' => now(),
                    ]);
                }
            }

            // ¡CAMBIO CLAVE! Devolvemos una respuesta JSON de éxito.
            return response()->json([
                'success' => true,
                'message' => 'Historial del paciente actualizado correctamente.'
            ]);
        } catch (\Exception $e) {
            // En caso de error, devolvemos un JSON de error.
            Log::error('Error actualizando historial: ' . $e->getMessage());
            return response()->json([
                'success' => false,
                'message' => 'Ocurrió un error al actualizar el historial.'
            ], 500); // Código de estado 500 para error del servidor
        }
    }

    /**
     * Obtiene la lista de archivos de un paciente específico.
     */
    public function deleteFile($fileId)
    {
        try {
            Log::info('🗑️ Intentando eliminar archivo:', ['file_id' => $fileId]);

            // Buscar el archivo
            $file = ClinicalHistories::find($fileId);

            if (!$file) {
                Log::warning('❌ Archivo no encontrado:', ['file_id' => $fileId]);
                return response()->json([
                    'success' => false,
                    'message' => 'Archivo no encontrado'
                ], 404);
            }

            Log::info('📁 Archivo encontrado:', [
                'file_id' => $file->id,
                'patient_id' => $file->id_patient,
                'path' => $file->source_pdf
            ]);

            // Eliminar archivo físico
            if ($file->source_pdf && Storage::disk('public')->exists($file->source_pdf)) {
                $deleted = Storage::disk('public')->delete($file->source_pdf);
                Log::info('📁 Archivo físico eliminado:', ['success' => $deleted, 'path' => $file->source_pdf]);
            } else {
                Log::warning('⚠️ Archivo físico no existe:', ['path' => $file->source_pdf]);
            }

            // Eliminar registro de base de datos
            $file->delete();
            Log::info('✅ Registro eliminado de base de datos');

            return response()->json([
                'success' => true,
                'message' => 'Archivo eliminado correctamente'
            ]);
        } catch (\Exception $e) {
            Log::error('❌ Error eliminando archivo:', [
                'file_id' => $fileId,
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString()
            ]);

            return response()->json([
                'success' => false,
                'message' => 'Error interno del servidor: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
     * Obtener archivos del paciente - MANTENER ESTE MÉTODO
     */
    public function getPatientFiles($id)
    {
        try {
            $patient = Patient::findOrFail($id);

            // Busca en la tabla 'clinical_histories'
            $files = ClinicalHistories::where('id_patient', $patient->id)->get();

            $formattedFiles = $files->map(function ($file) {
                $fileName = basename($file->source_pdf);

                return [
                    'id' => $file->id,
                    'name' => $fileName,
                    'url' => Storage::url($file->source_pdf),
                ];
            });

            return response()->json([
                'success' => true,
                'files' => $formattedFiles
            ]);
        } catch (\Exception $e) {
            Log::error('Error cargando archivos del paciente:', [
                'patient_id' => $id,
                'error' => $e->getMessage()
            ]);

            return response()->json([
                'success' => false,
                'message' => 'Error al cargar archivos: ' . $e->getMessage()
            ], 500);
        }
    }
}
